# Postgres with pgvector (Neon's free tier has it).
DATABASE_URL=postgres://postgres@localhost:5432/voicebrief

# Free, no credit card: Groq (speech-to-text and notes) + Google Gemini (embeddings).
#   https://console.groq.com/keys     https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Or use OpenAI for everything:
# OPENAI_API_KEY=

# Optional overrides (defaults are picked from the keys above):
# TRANSCRIBE_PROVIDER=groq        # groq | openai | fake
# LLM_PROVIDER=groq               # groq | openai | gemini | fake
# EMBED_PROVIDER=gemini           # gemini | openai | fake
# LLM_MODEL=llama-3.3-70b-versatile

# Demo guard rails
MAX_AUDIO_MB=25
MEETINGS_PER_DAY=8
QUESTIONS_PER_HOUR=40
